<?xml version="1.0" encoding="utf-8"?><!--
    The API 31+ form of the same decision; see backup_rules.xml for why each exclusion is there.

    `device-transfer` repeats them rather than inheriting: a direct transfer to a new phone has the
    same problem as a cloud restore, because the keystore key does not travel either way.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync-secrets.xml" />
        <exclude domain="database" path="note-index.db" />
        <exclude domain="file" path="sync/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync-secrets.xml" />
        <exclude domain="database" path="note-index.db" />
        <exclude domain="file" path="sync/" />
    </device-transfer>
</data-extraction-rules>
