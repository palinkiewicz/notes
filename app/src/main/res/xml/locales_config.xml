<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages the app ships. Declaring them is what puts DakNote in the system's per-app language
  picker on Android 13 and later, so someone running a Polish phone can still read the app in
  English, or the other way round, without changing the whole device.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="pl" />
</locale-config>
