<?xml version="1.0" encoding="utf-8"?>
<!-- The library's ink-note glyph on the launcher icon's paper yellow. Adaptive, so the launcher
     masks it to the same shape as every other shortcut, and themed launchers get the monochrome
     layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_background" />
    <foreground android:drawable="@drawable/ic_shortcut_ink_glyph" />
    <monochrome android:drawable="@drawable/ic_shortcut_ink_glyph" />
</adaptive-icon>
