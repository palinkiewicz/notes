    <string name="settings_finger_drawing">Draw with finger</string>
    <string name="settings_finger_drawing_description">Turn on if your device has no stylus: the editor gets a button that lets a finger draw. Two fingers always pan and zoom.</string>
    <string name="settings_palm_window">Palm rejection window</string>
    <string name="settings_palm_window_description">Touches within this time of a stylus sample are ignored. Raise it if your hand still draws; lower it if touch feels unresponsive.</string>
    <string name="settings_palm_size">Palm size threshold</string>
    <string name="settings_palm_size_description">Contact patches wider than this are treated as a palm rather than a fingertip.</string>
    <string name="settings_smoothing">Stroke smoothing</string>
    <string name="settings_smoothing_description">A global multiplier on every tool\'s own smoothing.</string>
    <string name="settings_min_pressure">Minimum pressure</string>
    <string name="settings_min_pressure_description">Ignores the faint tail of a lifting pen.</string>
    <string name="settings_pressure_curve">Pressure response</string>
    <string name="settings_pressure_curve_description">Soft reaches full width with a lighter touch; firm needs more force.</string>
    <string name="settings_auto_shape">Auto-shape</string>
    <string name="settings_auto_shape_description">Hold the pen still at the end of a stroke to snap it to a line, curve, square, circle or polygon. Lift normally and the stroke is left as drawn.</string>
