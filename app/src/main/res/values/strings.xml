    <string name="settings_finger_drawing_description">Turn on if your device has no stylus: the editor gets a button that lets a finger draw. Two fingers always pan and zoom.</string>
    <string name="settings_palm_window">Palm rejection window</string>
    <string name="settings_palm_window_description">Touches within this time of a stylus sample are ignored. Raise it if your hand still draws; lower it if touch feels unresponsive.</string>
    <string name="settings_palm_size">Palm size threshold</string>
    <string name="settings_palm_size_description">Contact patches wider than this are treated as a palm rather than a fingertip.</string>
