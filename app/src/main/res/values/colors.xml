<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      What the platform paints before Compose draws its first frame. The stock Material window
      background is a near-white the app never chose, so a cold start flashes it. This is the
      default theme's own background; a user on another colour theme sees a much smaller step than
      a white one, and there is no way to vary it per theme without recreating the activity.
    -->
    <color name="window_background">#FFF9EE</color>
</resources>
