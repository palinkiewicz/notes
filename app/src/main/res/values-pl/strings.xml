    <string name="settings_finger_drawing">Rysowanie palcem</string>
    <string name="settings_finger_drawing_description">Włącz, jeśli Twoje urządzenie nie ma rysika: w edytorze pojawi się przycisk pozwalający rysować palcem. Dwa palce zawsze przesuwają i powiększają.</string>
    <string name="settings_palm_window">Okno odrzucania dłoni</string>
    <string name="settings_palm_window_description">Dotknięcia w tym czasie od próbki rysika są ignorowane. Zwiększ, jeśli dłoń nadal rysuje; zmniejsz, jeśli dotyk reaguje zbyt wolno.</string>
    <string name="settings_palm_size">Próg rozmiaru dłoni</string>
    <string name="settings_palm_size_description">Punkty styku szersze niż ten próg są traktowane jak dłoń, a nie opuszek palca.</string>
    <string name="settings_smoothing">Wygładzanie pociągnięć</string>
    <string name="settings_smoothing_description">Globalny mnożnik wygładzania każdego narzędzia.</string>
    <string name="settings_min_pressure">Minimalny nacisk</string>
    <string name="settings_min_pressure_description">Ignoruje przypadkowe lekkie dotknięcia piórem.</string>
    <string name="settings_pressure_curve">Reakcja na nacisk</string>
    <string name="settings_pressure_curve_description">Miękka osiąga pełną szerokość przy lżejszym dotyku; twarda wymaga większej siły.</string>
    <string name="settings_auto_shape">Automatyczne kształty</string>
    <string name="settings_auto_shape_description">Przytrzymaj pióro nieruchomo na końcu pociągnięcia, aby zamienić je w linię, łuk, kwadrat, koło lub wielokąt. Unieś je normalnie, a pociągnięcie zostanie takie, jak narysowane.</string>
    <string name="settings_auto_shape_hold">Czas przytrzymania</string>
    <string name="settings_auto_shape_hold_description">Jak długo pióro musi spoczywać, zanim kształt zostanie rozpoznany.</string>

